{
  "name": "ida-codemode-mcp",
  "version": "0.2.0",
  "description": "Code Mode MCP server for the ida-domain API, with Claude session correlation.",
  "mcpServers": {
    "ida": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "ida-codemode-mcp",
        "--agent",
        "claude"
      ],
      "env": {
        "IDA_CODEMODE_ID": "${IDA_CODEMODE_ID}"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(.*[_:])?ida__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project ${CLAUDE_PLUGIN_ROOT} ida-codemode-mcp --report-session=claude"
          }
        ]
      }
    ]
  }
}
