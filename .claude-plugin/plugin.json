{
  "name": "ida-mcp",
  "version": "0.6.1",
  "description": "Official IDA MCP server.",
  "mcpServers": {
    "ida": {
      "command": "uv",
      "args": [
        "run",
        "--with=ida-hcli",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "ida-nexus",
        "mcp",
        "--agent=claude"
      ],
      "env": {
        "ida_nexus_ID": "${ida_nexus_ID:-}",
        "IDAUSR": "${IDAUSR:-}",
        "ida_nexus_STATE_DIR": "${ida_nexus_STATE_DIR:-}"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(.*[_:])?ida__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project ${CLAUDE_PLUGIN_ROOT} ida-nexus mcp --report-session=claude"
          }
        ]
      }
    ]
  }
}
