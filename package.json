    "@earendil-works/pi-tui": "^0.80.7",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/ida-codemode.ts"
