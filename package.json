{
  "name": "ida-codemode-mcp",
  "version": "0.1.0",
  "description": "IDA Code Mode MCP server and Pi extension",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "ida",
    "reverse-engineering",
    "mcp"
  ],
