{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(.*[_:])?ida__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project ${PLUGIN_ROOT} ida-codemode-mcp report-session codex",
            "statusMessage": "Linking IDA trace to Codex session"
          }
        ]
      }
    ]
  }
}
